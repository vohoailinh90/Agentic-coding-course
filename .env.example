# Copy to .env and fill in. Never commit .env — it is ignored by .gitignore.
#
# Nothing in the repository reads these yet. They are reserved for the
# Facebook automation described in docs/facebook-plan.md (phase 2), so the
# names are settled before anyone pastes a real token into a script.

# Facebook Page that receives the posts (Graph API)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Language of the CLI messages: vi, en or ja
APP_LANG=vi
